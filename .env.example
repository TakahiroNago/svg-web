# Converter mode, fixed at build time.
#   wasm   (default when unset) convert in the browser with WebAssembly; images are not sent anywhere
#   server send images to the Go REST API, which calls the C++ engine over gRPC
# Any other value fails the build.
VITE_CONVERTER_MODE=

# Origin of the Go API, used only when VITE_CONVERTER_MODE=server.
# Leave empty to call /api/v1/convert on the same origin (AWS: docker/nginx.conf proxies /api/).
# Setting it in wasm mode fails the build. Do not include /api.
# Local example (docker compose up in svg-app):
#   VITE_CONVERTER_MODE=server
#   VITE_API_BASE_URL=http://localhost:8080
VITE_API_BASE_URL=
